<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/xp_panel"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xp_title_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/n_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="BlissPlayer"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/n_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/n_fav"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#00000000"
            android:scaleType="center"
            android:src="@drawable/notif_star_w" />

        <ImageButton
            android:id="@+id/n_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#00000000"
            android:scaleType="center"
            android:src="@drawable/ic_prev_w" />

        <ImageButton
            android:id="@+id/n_play"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#00000000"
            android:scaleType="center"
            android:src="@drawable/ic_pause_w" />

        <ImageButton
            android:id="@+id/n_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="#00000000"
            android:scaleType="center"
            android:src="@drawable/ic_next_w" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ProgressBar
            android:id="@+id/n_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="10dp"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/xp_notif_progress" />

        <TextView
            android:id="@+id/n_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0:00"
            android:textColor="#000000"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
