<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:paddingLeft="8dp"
    android:paddingRight="8dp">

    <!-- XP window title bar with icon -->
    <LinearLayout
        android:id="@+id/titleBarWrap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xp_title_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="BlissPlayer icon"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/titleBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="BlissPlayer"
            android:textAppearance="@style/XpTitleText" />

        <ImageButton
            android:id="@+id/searchToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#00000000"
            android:contentDescription="Search"
            android:scaleType="center"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- Tab row -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/xp_panel"
        android:elevation="4dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:orientation="horizontal">

        <Button android:id="@+id/tabSongs" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/tab_songs" android:background="@drawable/xp_button"
            android:textSize="11sp" android:minHeight="40dp" />
        <Button android:id="@+id/tabArtists" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/tab_artists" android:background="@drawable/xp_button"
            android:textSize="11sp" android:minHeight="40dp" />
        <Button android:id="@+id/tabAlbums" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/tab_albums" android:background="@drawable/xp_button"
            android:textSize="11sp" android:minHeight="40dp" />
        <Button android:id="@+id/tabGenres" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Genres" android:background="@drawable/xp_button"
            android:textSize="11sp" android:minHeight="40dp" />
        <Button android:id="@+id/tabPlaylists" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/tab_playlists" android:background="@drawable/xp_button"
            android:textSize="11sp" android:minHeight="40dp" />
        <Button android:id="@+id/tabMore" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/tab_more" android:background="@drawable/xp_button"
            android:textSize="11sp" android:minHeight="40dp" />
    </LinearLayout>

    <!-- Search + filters -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText android:id="@+id/searchBox" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:hint="Search songs"
            android:singleLine="true" android:inputType="text"
            android:minHeight="40dp" />
        <Button android:id="@+id/filterBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Filters" android:background="@drawable/xp_button"
            android:minHeight="40dp" android:layout_marginStart="6dp" />
        <Button android:id="@+id/searchClear" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="X" android:background="@drawable/xp_button"
            android:minHeight="40dp" android:layout_marginStart="6dp" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chipsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <!-- Big friendly actions: Play split so last slice shuffles -->
    <LinearLayout
        android:id="@+id/playRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/xp_panel"
        android:elevation="4dp"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:orientation="horizontal">

        <Button android:id="@+id/btnPlayAll" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="@string/play_all" android:background="@drawable/xp_start"
            android:textColor="#FFFFFF" android:textStyle="bold" android:minHeight="44dp" />
        <Button android:id="@+id/btnPlayShuffle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:text="Mix" android:background="@drawable/xp_start"
            android:textColor="#FFFFFF" android:textStyle="bold" android:minHeight="44dp" />
        <Button android:id="@+id/btnSort" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:text="Sort" android:background="@drawable/xp_button"
            android:minHeight="44dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/crumb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="13sp" />

    <Button
        android:id="@+id/playlistAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/xp_button"
        android:minHeight="40dp"
        android:text="Add songs"
        android:visibility="gone" />

    <!-- Explorer style column header for song lists -->
    <TextView
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xp_title_bar"
        android:padding="4dp"
        android:text="Title | Artist | Album | Time"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:layout_marginTop="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="0dp"
        android:layout_marginTop="4dp" />

    <ScrollView
        android:id="@+id/morePane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:elevation="0dp"
        android:fillViewport="true"
        android:layout_marginTop="4dp">
        <LinearLayout
            android:id="@+id/moreBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- XP status strip -->
    <TextView
        android:id="@+id/statusStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/xp_status"
        android:padding="6dp"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:singleLine="true"
        android:text="Welcome to BlissPlayer" />

    <!-- Mini player -->
    <LinearLayout
        android:id="@+id/miniPlayer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/xp_panel"
        android:padding="8dp"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:id="@+id/miniTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textStyle="bold" android:text="Nothing playing"
                    android:singleLine="true" />
                <TextView android:id="@+id/miniSub" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textSize="12sp"
                    android:text="Tap Play all music to start" android:singleLine="true" />
            </LinearLayout>

            <ImageButton android:id="@+id/miniPlayPause" android:layout_width="52dp"
                android:layout_height="44dp" android:background="@drawable/xp_button"
                android:contentDescription="Play or pause" android:scaleType="center"
                android:src="@drawable/ic_play" />
            <ImageButton android:id="@+id/miniNext" android:layout_width="52dp"
                android:layout_height="44dp" android:background="@drawable/xp_button"
                android:contentDescription="Next song" android:scaleType="center"
                android:src="@drawable/ic_next" />
            <ImageButton android:id="@+id/miniQueue" android:layout_width="52dp"
                android:layout_height="44dp" android:background="@drawable/xp_button"
                android:contentDescription="Now playing and queue" android:scaleType="center"
                android:src="@drawable/ic_queue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ProgressBar
                android:id="@+id/miniProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/miniTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="11sp"
                android:text="0:00" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
