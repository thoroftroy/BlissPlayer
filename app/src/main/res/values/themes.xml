<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlissPlayer.Day" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/xp_face</item>
        <item name="android:textColor">@color/xp_text</item>
        <item name="android:textColorSecondary">@color/xp_text_dim</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
        <item name="android:buttonStyle">@style/XpButton</item>
        <item name="android:buttonBarButtonStyle">@style/XpButton.Borderless</item>
        <item name="android:editTextStyle">@style/XpField.Day</item>
        <item name="android:scrollbarThumbVertical">@drawable/xp_scroll_thumb</item>
        <item name="android:scrollbarSize">6dp</item>
        <item name="android:scrollbarFadeDuration">0</item>
    </style>
    <style name="Theme.BlissPlayer.Night" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/xp_n_face</item>
        <item name="android:textColor">@color/xp_n_text</item>
        <item name="android:textColorSecondary">@color/xp_n_text_dim</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
        <item name="android:buttonStyle">@style/XpButton</item>
        <item name="android:buttonBarButtonStyle">@style/XpButton.Borderless</item>
        <item name="android:editTextStyle">@style/XpField.Night</item>
        <item name="android:scrollbarThumbVertical">@drawable/xp_scroll_thumb</item>
        <item name="android:scrollbarSize">6dp</item>
        <item name="android:scrollbarFadeDuration">0</item>
    </style>

    <!-- Every button in sentence case, like real XP. No shouty caps. -->
    <style name="XpButton" parent="Widget.AppCompat.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
    </style>

    <style name="XpButton.Borderless" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
    </style>

    <!-- Sunken white entry fields, classic style, per theme. -->
    <style name="XpField.Day" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/xp_field</item>
        <item name="android:textColor">@color/xp_text</item>
        <item name="android:textColorHint">@color/xp_text_dim</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="XpField.Night" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/xp_field_dark</item>
        <item name="android:textColor">@color/xp_n_text</item>
        <item name="android:textColorHint">@color/xp_n_text_dim</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="XpTitleText">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/xp_title_text</item>
        <item name="android:fontFamily">@font/ptsans</item>
        <item name="fontFamily">@font/ptsans</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
    </style>
</resources>
