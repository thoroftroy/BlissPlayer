<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Brushed silver base -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="@color/aq_title_top"
                android:centerColor="@color/aq_title_mid"
                android:endColor="@color/aq_title_bot" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Glass highlight across the top third -->
    <item android:bottom="20dp">
        <shape android:shape="rectangle">
            <gradient android:angle="-90"
                android:startColor="#CCFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Thin gray outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/aq_border" />
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
