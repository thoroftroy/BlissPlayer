<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Luna blue base with rounded top -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0"
                android:startColor="#0058E6"
                android:centerColor="#2A7FFF"
                android:endColor="#3A93FF" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Gloss highlight across the top half -->
    <item android:bottom="14dp">
        <shape android:shape="rectangle">
            <gradient android:angle="-90"
                android:startColor="#99FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <!-- Dark outline -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="#003C74" />
            <corners android:topLeftRadius="8dp" android:topRightRadius="8dp"
                android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</layer-list>
