<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4A525E" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A1D22" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90"
                        android:startColor="#26292F"
                        android:centerColor="#20242A"
                        android:endColor="#1A1D22" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4A525E" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90"
                        android:startColor="#3A4048"
                        android:centerColor="#2E333A"
                        android:endColor="#26292F" />
                    <corners android:radius="1dp" />
                </shape>
            </item>
            <item android:gravity="top" android:height="1dp"
                android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6A7280" />
                </shape>
            </item>
            <item android:gravity="left" android:width="1dp"
                android:left="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6A7280" />
                </shape>
            </item>
            <item android:gravity="bottom" android:height="2dp"
                android:left="1dp" android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#14161A" />
                </shape>
            </item>
            <item android:gravity="right" android:width="2dp"
                android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#14161A" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
