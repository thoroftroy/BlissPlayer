<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/xp_n_face" />
            <stroke android:width="1dp" android:color="@color/xp_n_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="@color/xp_n_button_top" android:endColor="@color/xp_n_button_bottom" />
            <stroke android:width="1dp" android:color="@color/xp_n_border" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</selector>
