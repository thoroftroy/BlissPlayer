<?xml version="1.0" encoding="utf-8"?>
<!-- Aqua gel pill button: blue gel default, deeper gel pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="-90"
                android:startColor="#1A5FA8"
                android:centerColor="#2E86D4"
                android:endColor="#7DB9E8" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#0E3D6E" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="-90"
                        android:startColor="@color/aq_gel_top"
                        android:centerColor="@color/aq_gel_mid"
                        android:endColor="@color/aq_gel_bot" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#0E3D6E" />
                </shape>
            </item>
            <item android:bottom="22dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="-90"
                        android:startColor="#B3FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"
                        android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
