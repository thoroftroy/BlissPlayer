<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="?attr/retroShadow" /></shape></item>
            <item android:left="1dp" android:right="1dp" android:top="1dp"><shape><solid android:color="?attr/retroFace" /></shape></item>
            <item android:height="3dp" android:gravity="top" android:left="1dp" android:right="1dp"><shape><solid android:color="#F5A23B" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape><solid android:color="?attr/retroShadow" /></shape></item>
            <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="1dp"><shape><solid android:color="?attr/retroLight" /></shape></item>
            <item android:left="2dp" android:top="3dp" android:right="1dp" android:bottom="2dp"><shape><solid android:color="?attr/retroFace" /></shape></item>
        </layer-list>
    </item>
</selector>
